# The run archive, stated once (owner, 26 Nov; notes section 78): every run's whole output, uploaded from the laptop with
# rclone and the owner's AWS SSO session (no AWS credentials on pods). Read by ops/run_archive.py. Each archive is
# s3://$ARCHIVE_BUCKET/<run id>/.
ARCHIVE_BUCKET=rewardhack-run-archive
ARCHIVE_REGION=us-east-1
# Checkpoints and snapshots are rarely read: Standard-IA, about $0.0125/GB-month, 30-day minimum, $0.01/GB to read back.
ARCHIVE_STORAGE_CLASS=STANDARD_IA
# The rclone the wrapper accepts (`brew install rclone`; the wrapper refuses any other version).
RCLONE_VERSION=v1.76.0
# How long a presigned URL handed to a pod for a resume stays valid. All of a resume's URLs are signed at once and the pod
# fetches its files one after another: 1.5x an estimated 30 minutes for the whole 2.3 GB checkpoint (13 at 3 MB/s, plus the
# time to hand the lines to the pod). It must fit inside the SSO role credentials that sign it (an hour by default).
ARCHIVE_URL_SECONDS=2700
