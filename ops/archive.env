# The run archive, stated once (owner, 26 Nov; notes section 78): every run's whole output, uploaded from the laptop with the
# owner's AWS SSO session (no AWS credentials on pods). Sourced by ops/s3_archive.sh.
ARCHIVE_BUCKET=rewardhack-run-archive
ARCHIVE_REGION=us-east-1
# Checkpoints and snapshots are rarely read: Standard-IA, about $0.0125/GB-month, 30-day minimum, $0.01/GB to read back.
ARCHIVE_STORAGE_CLASS=STANDARD_IA
# Each run at s3://$ARCHIVE_BUCKET/$ARCHIVE_PREFIX/<results folder name>/, the layout of results/ on the laptop.
ARCHIVE_PREFIX=results
# How long a presigned URL handed to a pod for a resume stays valid: a pod fetches its checkpoint in its first minutes.
ARCHIVE_URL_SECONDS=3600
