# What every pod script shares, stated once (owner, 26 Nov): plain assignments, sourced by ops/pod_lib.sh and by the
# older inference-only scripts that do not take pod_lib's strict mode. tests/test_shared_constants.py holds these equal
# to the library's copies (entrypoints/run.py's pod judge, verifier.LEAN_VERSION, the rollout URL in vllm_rollouts).
# The vLLM version is pinned once, in requirements-vllm.txt, except for the two older inference-only probes below.
# PROBE_VLLM_VERSION: what remote_runpod_probe.sh and remote_runpod_open_reasoning.sh ran with. They install vLLM and the
# project together, which requirements-vllm.txt cannot do (its numpy pin differs from the project's), and their earlier
# results were measured on this version (review round 17).
PROBE_VLLM_VERSION=0.33.0
GPT_OSS_20B=openai/gpt-oss-20b
GPT_OSS_20B_REV=6cee5e81ee83917806bbde320786a8fb61efebee
GPT_OSS_120B=openai/gpt-oss-120b
GPT_OSS_120B_REV=b5c939de8f754692c1647ca79fbf85e8c1e70f8a
POD_JUDGE=Qwen/Qwen3-8B
POD_JUDGE_REV=b968826d9c46dd6066d109eabc6255188de91218
LEAN_VERSION=4.19.0
ROLLOUT_PORT=8011
JUDGE_PORT=8012
