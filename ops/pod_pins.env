# What every pod script shares, stated once (owner, 26 Nov): plain assignments, sourced by ops/pod_lib.sh and by the
# driver. tests/test_shared_constants.py holds these equal to the library's copies (entrypoints/run.py's pod judge,
# verifier.LEAN_VERSION, the rollout URL in vllm_rollouts). The vLLM version is pinned once, in requirements-vllm.txt.
GPT_OSS_20B=openai/gpt-oss-20b
GPT_OSS_20B_REV=6cee5e81ee83917806bbde320786a8fb61efebee
GPT_OSS_120B=openai/gpt-oss-120b
GPT_OSS_120B_REV=b5c939de8f754692c1647ca79fbf85e8c1e70f8a
QWEN3_32B=Qwen/Qwen3-32B
QWEN3_32B_REV=9216db5781bf21249d130ec9da846c4624c16137
POD_JUDGE=Qwen/Qwen3-8B
POD_JUDGE_REV=b968826d9c46dd6066d109eabc6255188de91218
LEAN_VERSION=4.19.0
# Part 1 jobs, indexed by SMOKE_PART_ONE (0 is the preflight run, not a Part 1 job): the runs, one after the other with the
# same seed and settings, each as name:arm:penalty. The smoke script runs them; the driver sizes the deadline from their count.
# 1: the baseline and λ=0 pair (owner, 26 Nov). 2: λ=0.5 alone, to see whether refutations emerge unseeded when a verified
# refutation outscores a disclosed exploit (owner, 26 Nov; notes section 77). 3: no runs, only the gpt-oss-120b probe
# (SMOKE_PROBE_LARGE=1, which the driver then requires), for a relaunch that fixes the probe without repeating a training run.
# 4: Qwen3-32B with thinking at λ=0.5 alone (owner, 26 Nov; notes section 80): the 60-step survey run, and with SMOKE_STEPS
# at 4 to 8 its measuring pass.
PART_ONE_RUNS=('' 'baseline:baseline:0 lambda0:report_correct:0' 'lambda05:report_correct:0.5' '' 'lambda05:report_correct:0.5')
# The training model of each job above, as an index into the MODEL_* rows below (0 for the preflight run).
PART_ONE_MODEL=(0 0 0 0 1)
# Training models, one column each (bash 3.2 on the laptop has no associative arrays): 0 gpt-oss-20b, 1 Qwen3-32B.
MODEL_REPOS=("$GPT_OSS_20B" "$QWEN3_32B")
MODEL_REVS=("$GPT_OSS_20B_REV" "$QWEN3_32B_REV")
# The trainer's model options. gpt-oss: low effort (where the 12/60 base rate was measured), eager attention (its only
# kind), 4-bit experts expanded to bf16. Qwen3-32B: thinking on (owner, 26 Nov), dense, sdpa.
MODEL_ARGS=('--reasoning-effort low --thinking unsupported --attn-implementation eager --mxfp4 dequantize'
            '--thinking on --attn-implementation sdpa --mxfp4 absent')
# Cards per pod. Qwen3-32B in bf16 is 65.5 GB, and the vLLM rollout server holds its own copy, awake beside the
# trainer's while it samples: 131 GB of weights alone, more than one 96 GB card. Two cards: the trainer on the first,
# vLLM on the second (notes section 80). The trainer's --quant 4bit would fit one card, but vLLM rollouts refuse a
# quantized trainer (the policy sampled would not be the one trained), and the trainer's own sampler is many times slower.
MODEL_GPUS=(1 2)
# The rollout server's share of its card: beside the trainer on one card, or a card of its own.
MODEL_ROLLOUT_FRACTION=(0.30 0.85)
TRAIN_PROMPTS_PER_STEP=4
DEFAULT_TRAIN_GENERATIONS=4
# GB under /workspace for the environments, the uv cache and the weights (13 GB and 65.5 GB).
MODEL_WORKSPACE_GB=(40 95)
# The weights' download, each limit in its own variable so the cap test reads its basis.
# cap: 2x measured 5.1 min (gpt-oss-20b, 13 GB)
DOWNLOAD_20B_SECONDS=660
# cap: 1.5x estimated 26 min (65.5 GB at 43 MB/s, the 20b's slowest rate with xet; never fetched on a pod)
DOWNLOAD_32B_SECONDS=2400
MODEL_DOWNLOAD_LIMITS=("$DOWNLOAD_20B_SECONDS" "$DOWNLOAD_32B_SECONDS")
# Setup before the first training step (install, download, vLLM start), which the driver adds to a Part 1 job's deadline.
# cap: 2x measured 15 min (gpt-oss-20b, 25 Nov)
SETUP_20B_MINUTES=30
# At least its inner limits: the 40-minute download, the 15-minute vLLM start wait, and the install beside the download
# (review round 32: 54 was below them, so a slow but legal setup ended the run early). Never run.
# cap: 1.5x estimated 47 min
SETUP_32B_MINUTES=71
MODEL_SETUP_LIMITS=("$SETUP_20B_MINUTES" "$SETUP_32B_MINUTES")
# The gpt-oss-120b probe after a Part 1 job (SMOKE_PROBE_LARGE=1). Each stage: a wait for a freed card, its own
# --max-seconds (model load and FlashInfer's kernel build included), then an outer limit EXIT seconds longer that sends
# TERM, and KILL after KILL_AFTER more. The smoke script runs PROBE_LARGE_STAGES in order; the driver sums the same list
# into the deadline it requires. The download runs beside the training; the driver counts any of it that could outlast
# the training. Limits are checked against their cap comments by tests/test_cap_comments.py.
# cap: 1.5x estimated 13 min (low effort, 320 answers, after a load and kernel build of several minutes; never run)
PROBE_LARGE_LOW_SECONDS=1200
# cap: 1.5x estimated 20 min (high effort, 80 answers of up to 8,192 tokens; never run)
PROBE_LARGE_HIGH_SECONDS=1800
# Each stage as "effort seconds samples max-tokens chunk", in the order they run. A chunk is the prompts sampled (and
# saved) together: each waits for its longest answer, so a larger one is faster, a smaller one keeps more when the
# stage is stopped at its limit. About 40 sequences of 9k tokens fit beside the weights; 20 prompts x 4 samples of 3k do.
PROBE_LARGE_STAGES=("low $PROBE_LARGE_LOW_SECONDS 4 2048 20" "high $PROBE_LARGE_HIGH_SECONDS 1 8192 40")
# cap: 1.5x estimated 200 s (importing vLLM and reading a tokenizer: the probe environment's check before the training)
PROBE_ENV_CHECK_SECONDS=300
# cap: 1.5x estimated 200 s (vLLM's engine shutdown after the deadline)
PROBE_LARGE_EXIT_SECONDS=300
# A new pod's boot until it accepts SSH: the driver's whole wait for it, and what the launch gate's worst case counts
# before the provisional timer is armed (gates.overhead_minutes). Generous on purpose: a pod given up on has no removal
# timer and bills until someone terminates it, so a slow image pull on a fresh host is waited for (review round 32).
# cap: 6x measured 1.5 min
SSH_UP_SECONDS=540
# The driver's call that arms the provisional timer (one SSH session, one RunPod API query, a 1 to 5 s proof that the
# timer runs), also counted by the gate before the timer exists.
# cap: 3x estimated 20 s
ARM_SECONDS=60
# cap: 3x estimated 10 s (a process that ignored TERM, killed outright)
KILL_AFTER_SECONDS=30
# cap: 2.1x estimated 37.5 min (about 65 GB at 30 MB/s without xet; the 13 GB gpt-oss-20b came at 43 to 62 MB/s with it)
LARGE_DOWNLOAD_SECONDS=4800
# cap: 3x estimated 20 s (a stopped vLLM server releases its memory within seconds)
CARD_FREE_SECONDS=60
# cap: 3x estimated 3 s (one nvidia-smi query; it can hang on a wedged card)
NVIDIA_SMI_SECONDS=10
# Room for the prompt in a vLLM context sized to its answers (rollout server and probe alike): the prompt is a few
# hundred tokens. A fixed context once refused every request when the answer limit grew (review round 6).
PROMPT_ROOM_TOKENS=2048
ROLLOUT_PORT=8011
JUDGE_PORT=8012
